<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Noclip - The Backrooms</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #111;
      font-family: Arial, sans-serif;
    }

    video {
      width: 90%;
      max-width: 1000px;
      border-radius: 12px;
      box-shadow: 0 0 30px #000;
    }
  </style>
</head>

<body>

  <video controls>
    <source src="video.mp4" type="video/mp4">
    Your browser does not support MP4 video.
  </video>

</body>
</html>
